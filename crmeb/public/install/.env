APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Ho_Chi_Minh
; Khóa ký JWT. Trình cài đặt sinh ngẫu nhiên cho mỗi bản cài; đổi khóa thì mọi phiên đăng nhập hết hiệu lực.
APP_KEY = #APP_KEY#
; Cho phép bộ sinh mã CRUD ghi file và sửa bảng trên server (true/false). Mặc định tắt.
CRUD_MAKE = false

[DATABASE]
TYPE = mysql
HOSTNAME = #DB_HOST#
HOSTPORT = #DB_PORT#
USERNAME = #DB_USER#
PASSWORD = #DB_PWD#
DATABASE = #DB_NAME#
PREFIX = #DB_PREFIX#
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = vi-vn

[CACHE]
DRIVER = #CACHE_TYPE#
CACHE_PREFIX = #CACHE_PREFIX#
CACHE_TAG_PREFIX = #CACHE_TAG_PREFIX#

[REDIS]
REDIS_HOSTNAME = #RB_HOST#
PORT = #RB_PORT#
REDIS_PASSWORD = #RB_PWD#
SELECT = #RB_SELECT#

[QUEUE]
QUEUE_NAME = #QUEUE_NAME#

[FILESYSTEM]
; Mật khẩu trình sửa file online. Để trống = tắt trình sửa file.
PASSWORD =

[UPGRADE]
; Nâng cấp trực tuyến và nâng cấp xuyên phiên bản từ upgrade.crmeb.net (true/false). Mặc định tắt.
ONLINE_ENABLE = false
