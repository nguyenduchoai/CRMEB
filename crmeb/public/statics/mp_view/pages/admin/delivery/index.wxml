w class="uni-input">{{logistics[seIndex].name}}</view></picker></view><text class="iconfont icon-ic_rightarrow"></text></view><view class="item acea-row row-middle"><view>Mã vận đơn</view><input class="mode" type="text" placeholder="Vui lòng nhập" data-event-opts="{{[['input',[['__set_model',['','delivery_id','$event',[]]]]]]}}" value="{{delivery_id}}" bindinput="__e"/><text data-event-opts="{{[['tap',[['scanCode',['$event']]]]]}}" class="iconfont icon-xiangji" bindtap="__e"></text></view><view class="item"><block wx:if="{{curExpress==1}}"><view class="trip">Với SF Express, vui lòng nhập mã vận đơn: 4 số cuối số điện thoại người nhận hoặc người gửi</view></block><block wx:if="{{curExpress==1}}"><view class="trip">Ví dụ: SF000000000000:3941</view></block></view></block></block><block wx:if="{{curExpress==2}}"><block><view class="item acea-row row-between-wrapper"><view>Họ tên người gửi</view><input class="mode" type="text" placeholder="Điền họ tên người gửi" data-event-opts="{{[['input',[['__set_model',['','to_name','$event',[]]]]]]}}" value="{{to_name}}" bindinput="__e"/></view><view class="item acea-row row-between-wrapper"><view>Số điện thoại người gửi</view><input class="mode" type="text" placeholder="Điền số điện thoại người gửi" data-event-opts="{{[['input',[['__set_model',['','to_tel','$event',[]]]]]]}}" value="{{to_tel}}" bindinput="__e"/></view><view class="item acea-row row-between-wrapper"><view>Địa chỉ người gửi</view><input class="mode" type="text" placeholder="Điền địa chỉ người gửi" data-event-opts="{{[['input',[['__set_model',['','to_addr','$event',[]]]]]]}}" value="{{to_addr}}" bindinput="__e"/></view><view class="item acea-row row-between-wrapper"><view>Đơn vị vận chuyển</view><view class="select-box"><picker class="pickerBox" value="{{seIndex}}" range="{{logistics}}" range-key="name" data-event-opts="{{[['change',[['bindPickerChange',['$event']]]]]}}" bindchange="__e"><view class="uni-input">{{logistics[seIndex].name}}</view></picker></view></view>