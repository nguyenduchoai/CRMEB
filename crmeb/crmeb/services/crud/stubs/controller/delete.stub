    /**
     * Xóa
     * @param $id
     * @return \think\Response
     * @date {%DATE%}
     */
    public function delete($id)
    {
        if (!$id) {
            return app('json')->fail('Tham số không hợp lệ');
        }

        if ($this->service->destroy((int)$id)) {
            return app('json')->success('Xóa thành công');
        } else {
            return app('json')->fail('Xóa thất bại');
        }
    }
